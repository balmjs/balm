{
  "name": "balm",
  "version": "6.0.0-alpha.5",
  "type": "module",
  "description": "Next-generation frontend build workflow",
  "keywords": [
    "balm",
    "balmjs",
    "web",
    "app",
    "front-end",
    "workflow"
  ],
  "homepage": "https://balm.js.org",
  "license": "MIT",
  "author": {
    "name": "Elf-mousE",
    "email": "ifmouz@gmail.com",
    "url": "http://elf-mouse.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balmjs/balm.git",
    "directory": "packages/balm"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "balm": "./bin/balm.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "balm-core": "workspace:*",
    "cac": "^6.7.14",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
