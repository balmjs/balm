{
  "name": "balm-core",
  "version": "6.0.0-alpha.1",
  "type": "module",
  "description": "Next-generation core build engine for BalmJS",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "connect": "^3.7.0",
    "cssnano": "^7.0.6",
    "esbuild": "^0.25.0",
    "fast-glob": "^3.3.3",
    "html-minifier-terser": "^7.2.0",
    "http-proxy-middleware": "^3.0.3",
    "less": "^4.2.2",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.2",
    "postcss": "^8.5.3",
    "postcss-preset-env": "^10.1.4",
    "rollup": "^4.34.8",
    "sass": "^1.85.0",
    "serve-static": "^1.16.2",
    "ssh2": "^1.16.0",
    "terser": "^5.39.0",
    "webpack": "^5.98.0",
    "workbox-build": "^7.3.0",
    "workbox-sw": "^7.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/archiver": "^6.0.3",
    "@types/connect": "^3.4.38",
    "@types/less": "^3.0.7",
    "@types/picomatch": "^3.0.2",
    "@types/serve-static": "^1.15.7",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.5.14",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
