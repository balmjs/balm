{
  "compilerOptions": {
    // Type Checking
    "strict": true,
    // Modules
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@balm-core/index.js": ["./packages/balm-core/index.d.ts"],
      "@balm-core/*": ["./packages/balm-core/src/*"]
    },
    // Project Options
    "importHelpers": true,
    "lib": ["ESNext", "DOM"],
    // Emit
    "rootDir": "packages/balm-core/src",
    "outDir": "packages/balm-core/tslib",
    "removeComments": true,
    // Language and Environment
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ESNext",
    // Interop Constraints
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    // Completeness
    "skipLibCheck": true
  },
  "include": [
    "packages/balm-core/src/**/*",
    "packages/balm-core/index.d.ts",
    "packages/balm-core/types/**/*"
  ],
  "exclude": ["node_modules", "coverage", "lib", "tslib"]
}
