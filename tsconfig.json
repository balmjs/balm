{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "balm-core": ["packages/balm-core/src/index.ts"],
      "balm": ["packages/balm/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "lib", "coverage", ".tmp", ".output"]
}
