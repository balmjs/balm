{
  "name": "balmjs",
  "version": "6.0.0-alpha.0",
  "private": true,
  "description": "Next-generation frontend build workflow powered by native Node.js",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "playground:build": "node ./packages/balm/bin/balm.js ./playground/balm.config.js -p"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.7",
    "normalize.css": "^8.0.1",
    "prettier": "^3.5.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@9.15.4"
}
